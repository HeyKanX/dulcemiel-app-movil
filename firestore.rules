rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /buzon_sugerencias/{sugerenciaId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'mensaje',
          'categoria',
          'fechaCreacion',
          'uid'
        ])
        && request.resource.data.keys().hasOnly([
          'mensaje',
          'categoria',
          'fechaCreacion',
          'uid'
        ])
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() >= 10
        && request.resource.data.mensaje.size() <= 1000
        && request.resource.data.categoria in [
          'producto',
          'servicio',
          'app',
          'otro'
        ]
        && request.resource.data.fechaCreacion == request.time
        && request.resource.data.uid == request.auth.uid;

      allow read, update, delete: if false;
    }
  }
}
